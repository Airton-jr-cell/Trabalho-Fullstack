<UserControl x:Class="CineCatalogo.Views.FilmesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="5,15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TituloPagina" FontSize="24" FontWeight="SemiBold"/><DockPanel Margin="0,15,0,10"><Button Content="Pesquisar" DockPanel.Dock="Right" Click="Pesquisar_Click"/><TextBox x:Name="Pesquisa" ToolTip="Pesquise por título ou gênero"/></DockPanel></StackPanel><DataGrid x:Name="Tabela" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Tabela_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/><DataGridTextColumn Header="Gênero" Binding="{Binding Genero}" Width="160"/><DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="80"/><DataGridTextColumn Header="Duração (min)" Binding="{Binding Duracao}" Width="120"/></DataGrid.Columns></DataGrid><StackPanel x:Name="Editor" Grid.Row="2" Margin="0,10,0,0"><WrapPanel><StackPanel Width="245"><TextBlock Text="Título"/><TextBox x:Name="Titulo"/></StackPanel><StackPanel Width="170"><TextBlock Text="Gênero"/><TextBox x:Name="Genero"/></StackPanel><StackPanel Width="90"><TextBlock Text="Ano"/><TextBox x:Name="Ano"/></StackPanel><StackPanel Width="105"><TextBlock Text="Duração"/><TextBox x:Name="Duracao"/></StackPanel></WrapPanel><TextBlock Text="Sinopse"/><TextBox x:Name="Sinopse" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><WrapPanel><Button Content="Novo" Click="Novo_Click"/><Button Content="Salvar" Click="Salvar_Click"/><Button Content="Excluir" Click="Excluir_Click"/></WrapPanel></StackPanel></Grid></UserControl>
